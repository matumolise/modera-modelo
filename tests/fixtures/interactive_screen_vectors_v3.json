{
  "schema_version": "interactive-screen-vectors-v3-draft",
  "units": "minute offsets from day_start_utc; intervals are [begin, end)",
  "default_day_start_utc": "2026-10-05T00:00:00Z",
  "default_day_end_utc": "2026-10-06T00:00:00Z",
  "vectors": [
    {
      "id": "ordered_equal_timestamp",
      "queries": [{"id": "q1", "begin": -60, "end": 1440, "success": true,
        "events": [[-30, 16, 0], [60, 15, 1], [120, 15, 3], [120, 16, 2], [180, 16, 4]]}],
      "expected": {"status": "OBSERVED", "minutes": 120.0, "reason": null}
    },
    {
      "id": "ambiguous_equal_timestamp",
      "queries": [{"id": "q1", "begin": -60, "end": 1440, "success": true,
        "events": [[-30, 16, 0], [60, 15, 1], [120, 16, 2], [120, 15, 2], [180, 16, 3]]}],
      "expected": {"status": "MISSING", "minutes": null, "reason": "AMBIGUOUS_EVENT_ORDER"}
    },
    {
      "id": "interactive_across_midnight",
      "queries": [{"id": "q1", "begin": -60, "end": 1440, "success": true,
        "events": [[-30, 15, 0], [30, 16, 1]]}],
      "expected": {"status": "OBSERVED", "minutes": 30.0, "reason": null}
    },
    {
      "id": "consistent_overlap_no_destructive_deduplication",
      "queries": [
        {"id": "q1", "begin": -60, "end": 1440, "success": true,
         "events": [[-30, 16, 0], [60, 15, 1], [120, 16, 2]]},
        {"id": "q2", "begin": 0, "end": 240, "success": true,
         "events": [[60, 15, 0], [120, 16, 1]]}
      ],
      "expected": {"status": "OBSERVED", "minutes": 60.0, "reason": null}
    },
    {
      "id": "conflicting_overlap",
      "queries": [
        {"id": "q1", "begin": -60, "end": 1440, "success": true,
         "events": [[-30, 16, 0], [60, 15, 1], [120, 16, 2]]},
        {"id": "q2", "begin": 0, "end": 240, "success": true,
         "events": [[60, 15, 0], [90, 16, 1], [120, 16, 2]]}
      ],
      "expected": {"status": "MISSING", "minutes": null, "reason": "CONFLICTING_OVERLAPPING_QUERIES"}
    },
    {
      "id": "two_queries_with_partial_overlap",
      "queries": [
        {"id": "q1", "begin": -60, "end": 600, "success": true,
         "events": [[-30, 16, 0], [60, 15, 1], [120, 16, 2], [570, 15, 3]]},
        {"id": "q2", "begin": 540, "end": 1440, "success": true,
         "events": [[570, 15, 0], [630, 16, 1]]}
      ],
      "expected": {"status": "OBSERVED", "minutes": 120.0, "reason": null}
    },
    {
      "id": "failed_query_redundant",
      "queries": [
        {"id": "q1", "begin": -60, "end": 1440, "success": true,
         "events": [[-30, 16, 0], [60, 15, 1], [120, 16, 2]]},
        {"id": "q2", "begin": 0, "end": 240, "success": false, "events": []}
      ],
      "expected": {"status": "OBSERVED", "minutes": 60.0, "reason": null}
    },
    {
      "id": "uncovered_query_gap",
      "queries": [
        {"id": "q1", "begin": -60, "end": 120, "success": true,
         "events": [[-30, 16, 0], [60, 15, 1]]},
        {"id": "q2", "begin": 180, "end": 1440, "success": true,
         "events": [[240, 16, 0]]}
      ],
      "expected": {"status": "MISSING", "minutes": null, "reason": "INCOMPLETE_QUERY_COVERAGE"}
    },
    {
      "id": "open_interval_across_restart",
      "queries": [{"id": "q1", "begin": -60, "end": 1440, "success": true,
        "events": [[-30, 16, 0], [60, 15, 1], [120, 26, 2], [130, 27, 3],
                   [150, 15, 4], [180, 16, 5]]}],
      "expected": {"status": "MISSING", "minutes": null, "reason": "OPEN_INTERVAL_ACROSS_RESTART"}
    },
    {
      "id": "unknown_state_after_restart",
      "queries": [{"id": "q1", "begin": -60, "end": 1440, "success": true,
        "events": [[-30, 16, 0], [120, 26, 1], [130, 27, 2], [150, 15, 3], [180, 16, 4]]}],
      "expected": {"status": "MISSING", "minutes": null, "reason": "UNKNOWN_STATE_AFTER_RESTART"}
    },
    {
      "id": "known_zero",
      "queries": [{"id": "q1", "begin": -60, "end": 1440, "success": true,
        "events": [[-30, 16, 0]]}],
      "expected": {"status": "OBSERVED_ZERO", "minutes": 0.0, "reason": null}
    },
    {
      "id": "restart_before_day_then_known_noninteractive",
      "queries": [{"id": "q1", "begin": -60, "end": 1440, "success": true,
        "events": [[-55, 26, 0], [-50, 27, 1], [-30, 16, 2]]}],
      "expected": {"status": "OBSERVED_ZERO", "minutes": 0.0, "reason": null}
    },
    {
      "id": "unknown_initial_state_is_not_zero",
      "queries": [{"id": "q1", "begin": 0, "end": 1440, "success": true, "events": []}],
      "expected": {"status": "MISSING", "minutes": null, "reason": "INITIAL_STATE_UNKNOWN"}
    },
    {
      "id": "twenty_five_hour_local_day",
      "time_zone": "Europe/Madrid",
      "day_start_utc": "2026-10-24T22:00:00Z",
      "day_end_utc": "2026-10-25T23:00:00Z",
      "queries": [{"id": "q1", "begin": -60, "end": 1500, "success": true,
        "events": [[-30, 15, 0]]}],
      "expected": {"status": "OBSERVED", "minutes": 1500.0, "reason": null}
    },
    {
      "id": "event_at_exclusive_day_end",
      "queries": [{"id": "q1", "begin": -60, "end": 1441, "success": true,
        "events": [[-30, 15, 0], [1440, 16, 1]]}],
      "expected": {"status": "OBSERVED", "minutes": 1440.0, "reason": null}
    }
  ]
}
