# Generar una credencial propia; el valor vacío impide iniciar.
ANALYTICS_SERVICE_TOKEN=
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=8765
ANALYTICS_PMUM_ENABLED=false
ANALYTICS_ACTIVITIES_ENABLED=true
ANALYTICS_HISTORICAL_ENABLED=false
# Para habilitar el histórico, proporcionar perfil C1 y repositorio persistente.
# ANALYTICS_HISTORICAL_CONFIG_PATH=/config/historical.json
# ANALYTICS_HISTORICAL_REPOSITORY_PATH=/var/lib/modera/historical/history.json
# Tiempo máximo de recepción del cuerpo; no es deadline de inferencia.
ANALYTICS_REQUEST_TIMEOUT_SECONDS=10
# Para activar PMUM, indicar archivo y manifiesto de fuente confiable.
# ANALYTICS_MODEL_PATH=/models/hu_pmum_sf_experimental_v1.joblib
# ANALYTICS_MODEL_MANIFEST_PATH=/models/hu_pmum_sf_experimental_v1.json
# ANALYTICS_MODEL_SHA256=<64 caracteres hexadecimales de fuente confiable>
